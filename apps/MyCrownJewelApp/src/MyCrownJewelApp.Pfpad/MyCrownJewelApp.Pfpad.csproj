<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <AssemblyName>MyCrownJewelApp.Pfpad</AssemblyName>
    <RootNamespace>MyCrownJewelApp.Pfpad</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationVersion>1.0.48.0</ApplicationVersion>
    <Version>1.0.48.0</Version>
    <AssemblyVersion>1.0.48.0</AssemblyVersion>
    <FileVersion>1.0.48.0</FileVersion>
    <Company>Personal Flip Pad</Company>
    <Description>AIOps-aware developer editor and built-in browser with code editing, DevSecOps scanning, observability intelligence, Git integration, Roslyn IntelliSense, minimap, Vim mode, flat theme system, graded security hardening (Not Hardened / Low / Mid / Max) with DPAPI-encrypted settings and guided transition wizard, AI-assisted operational insights, and a WebView2 browser with YouTube ad blocking, 7 content filter lists, and CDN-safe path-specific rule filtering.</Description>
    <Copyright>Copyright (c) Dennis O. Esternon 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>$(DefineConstants);PROFILING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>$(DefineConstants);PROFILING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.3.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.*" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- MANUAL.md embedded as a resource with an explicit logical name so retrieval
         is stable across folder/namespace renames and works inside installed binaries. -->
    <EmbeddedResource Include="Resources\MANUAL.md">
      <LogicalName>MyCrownJewelApp.Pfpad.Resources.MANUAL.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\ARCHITECTURE.md">
      <LogicalName>MyCrownJewelApp.Pfpad.Resources.ARCHITECTURE.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\TERMINAL.md">
      <LogicalName>MyCrownJewelApp.Pfpad.Resources.TERMINAL.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\SECURITY_HARDENING.md">
      <LogicalName>MyCrownJewelApp.Pfpad.Resources.SECURITY_HARDENING.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="GenerateBuildMetadata" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <BuildDate>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))</BuildDate>
      <_MetadataOutputPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'BuildMetadata.g.cs'))</_MetadataOutputPath>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateBuildMetadata.ps1&quot; -OutputPath &quot;$(_MetadataOutputPath)&quot; -CommitHash &quot;$(GitCommitHash)&quot; -BuildDate &quot;$(BuildDate)&quot;" />
    <ItemGroup>
      <Compile Include="$(_MetadataOutputPath)" />
    </ItemGroup>
  </Target>

</Project>
